{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jibbers Map Studio",
  "version": "0.1.0",
  "identifier": "fun.jibbers.mapstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Jibbers Map Studio",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "visible": false,
        "backgroundColor": "#161616",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../library/": "library/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0MTgwMjMxMTI0OTkzNDcKUldSSGswa1NNUUlZZE1tTzhyek1KZVFDelE0R3MxcGhIRzB2MnV5V2Zvc0tyMlk4Nlp2a2dTK2gK",
      "endpoints": [
        "https://github.com/chrisrca/jibbers-map-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
